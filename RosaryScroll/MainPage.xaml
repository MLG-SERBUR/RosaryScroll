<Page
    x:Class="RosaryScroll.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RosaryScroll"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded"
    IsTabStop="True"
    KeyDown="Page_KeyDown"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <DataTemplate x:Key="PrayerSlideTemplate">
            <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <ScrollViewer x:Name="ImageScrollViewer"
                              ZoomMode="Enabled"
                              MinZoomFactor="1"
                              MaxZoomFactor="5"
                              HorizontalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid Width="{Binding ViewportWidth, ElementName=ImageScrollViewer}"
                          Height="{Binding ViewportHeight, ElementName=ImageScrollViewer}">
                        <Image Source="{Binding ImageSource}"
                               Stretch="Uniform"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch" />
                    </Grid>
                </ScrollViewer>
                <Border Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Padding="24,18"
                        Visibility="{Binding ControlsVisibility}">
                    <StackPanel>
                        <TextBlock Text="{Binding MysteryName}"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PrayerLabel}"
                                   FontSize="18"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MysteryTemplate">
            <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <FlipView ItemsSource="{Binding BrowseImages}"
                          ItemTemplate="{StaticResource PrayerSlideTemplate}"
                          SelectedIndex="{Binding ActiveImageIndex, Mode=TwoWay}"
                          SelectionChanged="MysteryImageFlipView_SelectionChanged"
                          UseTouchAnimationsForAllNavigation="True">
                    <FlipView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </FlipView.ItemsPanel>
                </FlipView>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid x:Name="TopOverlayGrid"
              VerticalAlignment="Top"
              IsHitTestVisible="False"
              Visibility="Collapsed"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Padding="16,12">
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextWrapping="NoWrap" />
                <TextBlock x:Name="InstructionText"
                           FontSize="14"
                           Margin="0,2,0,0"
                           TextWrapping="NoWrap"
                           Visibility="Collapsed" />
                <TextBlock x:Name="ProgressText"
                           FontSize="14"
                           Margin="0,2,0,0"
                           TextWrapping="NoWrap"
                           Visibility="Collapsed" />
            </StackPanel>
        </Grid>

        <FlipView x:Name="PrayerFlipView"
                  ItemTemplate="{StaticResource PrayerSlideTemplate}"
                  SelectionChanged="PrayerFlipView_SelectionChanged"
                  UseTouchAnimationsForAllNavigation="True"
                  Visibility="Collapsed"
                  Tapped="FlipView_Tapped">
            <FlipView.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </FlipView.ItemsPanel>
        </FlipView>

        <Pivot x:Name="MysteryPivot"
               ItemTemplate="{StaticResource MysteryTemplate}"
               SelectionChanged="MysteryPivot_SelectionChanged"
               Visibility="Visible"
               Tapped="FlipView_Tapped">
            <Pivot.HeaderTemplate>
                <DataTemplate>
                    <Grid Width="0" Height="0" />
                </DataTemplate>
            </Pivot.HeaderTemplate>
        </Pivot>

        <CommandBar x:Name="TopCommandBar"
                    VerticalAlignment="Bottom"
                    ClosedDisplayMode="Minimal"
                    IsSticky="False"
                    DefaultLabelPosition="Right">
            <AppBarToggleButton x:Name="ModeToggleButton"
                                Label="Mystery Browse"
                                Icon="List"
                                IsChecked="True"
                                Click="ModeToggleButton_Click" />
            <AppBarButton Icon="Back"
                          Label="Back"
                          Click="BackButton_Click" />
            <AppBarButton Icon="Previous"
                          Label="Prev Mystery"
                          Click="PreviousMysteryButton_Click" />
            <AppBarButton Icon="Next"
                          Label="Next Mystery"
                          Click="NextMysteryButton_Click" />
            <AppBarButton Icon="Undo"
                          Label="Rosary Progress"
                          Click="ModeButton_Click" />
            <CommandBar.SecondaryCommands>
                <AppBarButton Icon="Previous"
                              Label="Prev Mystery"
                              Click="PreviousMysteryButton_Click" />
                <AppBarButton Icon="Next"
                              Label="Next Mystery"
                              Click="NextMysteryButton_Click" />
            </CommandBar.SecondaryCommands>
        </CommandBar>
    </Grid>
</Page>
