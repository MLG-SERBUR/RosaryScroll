<Page
    x:Class="RosaryScroll.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RosaryScroll"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded"
    IsTabStop="True"
    KeyDown="Page_KeyDown"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <DataTemplate x:Key="PrayerSlideTemplate">
            <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <ScrollViewer x:Name="ImageScrollViewer"
                              ZoomMode="Enabled"
                              MinZoomFactor="1"
                              MaxZoomFactor="5"
                              HorizontalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid Width="{Binding ViewportWidth, ElementName=ImageScrollViewer}"
                          Height="{Binding ViewportHeight, ElementName=ImageScrollViewer}">
                        <Image Source="{Binding ImageSource}"
                               Stretch="Uniform"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch" />
                    </Grid>
                </ScrollViewer>
                <Border Background="#B0000000"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Bottom"
                        Padding="24,18"
                        Visibility="{Binding ControlsVisibility}">
                    <StackPanel>
                        <TextBlock Text="{Binding MysteryName}"
                                   Foreground="White"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PrayerLabel}"
                                   Foreground="#DDFFFFFF"
                                   FontSize="18"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MysteryTemplate">
            <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <FlipView ItemsSource="{Binding BrowseImages}"
                          ItemTemplate="{StaticResource PrayerSlideTemplate}"
                          SelectedIndex="{Binding ActiveImageIndex, Mode=TwoWay}"
                          SelectionChanged="MysteryImageFlipView_SelectionChanged"
                          UseTouchAnimationsForAllNavigation="True">
                    <FlipView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </FlipView.ItemsPanel>
                </FlipView>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <FlipView x:Name="PrayerFlipView"
                  ItemTemplate="{StaticResource PrayerSlideTemplate}"
                  SelectionChanged="PrayerFlipView_SelectionChanged"
                  UseTouchAnimationsForAllNavigation="True"
                  Tapped="FlipView_Tapped">
            <FlipView.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel Orientation="Vertical" />
                </ItemsPanelTemplate>
            </FlipView.ItemsPanel>
        </FlipView>

        <FlipView x:Name="MysteryFlipView"
                  ItemTemplate="{StaticResource MysteryTemplate}"
                  SelectionChanged="MysteryFlipView_SelectionChanged"
                  Visibility="Collapsed"
                  UseTouchAnimationsForAllNavigation="True"
                  Tapped="FlipView_Tapped" />

        <Grid x:Name="TopControlsGrid"
              Background="#E6000000"
              Padding="16,12"
              VerticalAlignment="Top"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           Text="RosaryScroll"
                           Foreground="White"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextWrapping="NoWrap" />
                <TextBlock x:Name="InstructionText"
                           Text="Swipe up for images. Swipe right for next mystery."
                           Foreground="#CCCCCC"
                           FontSize="14"
                           Margin="0,2,0,0"
                           TextWrapping="NoWrap"
                           Visibility="Collapsed" />
                <TextBlock x:Name="ProgressText"
                           Text="Joyful Mystery 1 of 5"
                           Foreground="#CCCCCC"
                           FontSize="14"
                           Margin="0,2,0,0"
                           TextWrapping="NoWrap" />
            </StackPanel>
            <ScrollViewer Grid.Row="1"
                          Margin="0,10,0,0"
                          HorizontalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button x:Name="BackButton"
                            Content="Back"
                            Margin="0,0,8,0"
                            Click="BackButton_Click" />
                    <Button x:Name="PreviousButton"
                            Content="Prev"
                            Margin="0,0,8,0"
                            Click="PreviousButton_Click" />
                    <ComboBox x:Name="ModeComboBox"
                              Width="166"
                              Margin="0,0,8,0"
                              SelectionChanged="ModeComboBox_SelectionChanged">
                        <ComboBoxItem Content="Rosary Progress" IsSelected="True" />
                        <ComboBoxItem Content="Mystery Browse" />
                    </ComboBox>
                    <Button x:Name="NextButton"
                            Content="Next"
                            Click="NextButton_Click" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Page>
