<Page
    x:Class="RosaryScroll.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RosaryScroll"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="Page_Loaded"
    IsTabStop="True"
    KeyDown="Page_KeyDown"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <DataTemplate x:Key="ImageTemplate">
            <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <ScrollViewer x:Name="ImageScrollViewer"
                              ZoomMode="Enabled"
                              MinZoomFactor="1"
                              MaxZoomFactor="5"
                              HorizontalScrollMode="Auto"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollMode="Auto"
                              VerticalScrollBarVisibility="Auto">
                    <Grid Width="{Binding ViewportWidth, ElementName=ImageScrollViewer}"
                          Height="{Binding ViewportHeight, ElementName=ImageScrollViewer}">
                        <Image Source="{Binding ImageSource}"
                               Stretch="Uniform"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch" />
                    </Grid>
                </ScrollViewer>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="MysteryTemplate">
            <Grid Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
                <FlipView ItemsSource="{Binding LoopingImages}"
                          ItemTemplate="{StaticResource ImageTemplate}"
                          SelectedIndex="{Binding ActiveImageIndex, Mode=TwoWay}"
                          SelectionChanged="MysteryImageFlipView_SelectionChanged"
                          UseTouchAnimationsForAllNavigation="True">
                    <FlipView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel Orientation="Vertical" />
                        </ItemsPanelTemplate>
                    </FlipView.ItemsPanel>
                </FlipView>
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <FlipView x:Name="MysteryFlipView"
                  ItemTemplate="{StaticResource MysteryTemplate}"
                  ManipulationMode="None"
                  PointerPressed="MysteryFlipView_PointerPressed"
                  SelectionChanged="MysteryFlipView_SelectionChanged"
                  UseTouchAnimationsForAllNavigation="True"
                  Tapped="FlipView_Tapped" />

        <Grid x:Name="TopOverlayGrid"
              VerticalAlignment="Top"
              Visibility="Collapsed"
              Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
              Padding="16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock x:Name="TitleText"
                           FontSize="22"
                           FontWeight="SemiBold"
                           TextWrapping="NoWrap" />
                <TextBlock x:Name="ProgressText"
                           FontSize="14"
                           Margin="0,2,0,0"
                           TextWrapping="NoWrap" />
                <TextBlock x:Name="InstructionText"
                           FontSize="14"
                           Margin="0,2,0,0"
                           Text="Swipe up for images."
                           TextWrapping="NoWrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button AutomationProperties.Name="Previous mystery"
                        Click="PreviousMysteryButton_Click">
                    <SymbolIcon Symbol="Back" />
                </Button>
                <Button AutomationProperties.Name="Next mystery"
                        Click="NextMysteryButton_Click">
                    <SymbolIcon Symbol="Forward" />
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
